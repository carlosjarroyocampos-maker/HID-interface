import threading
import time
import tkinter as tk
from tkinter import messagebox, scrolledtext
import hid


class JoystickMonitorApp:

  def __init__(self, root):
    self.root = root
    self.root.title("Monitor HID / Joystick - Data Stream")
    self.root.geometry("650x500")

    self.is_monitoring = False
    self.device = None
    self.monitor_thread = None

    # --- Marco de Configuración (IDs) ---
    config_frame = tk.LabelFrame(
        root, text=" Configuración de Dispositivo ", padx=10, pady=10
    )
    config_frame.pack(fill="x", padx=10, pady=5)

    tk.Label(config_frame, text="Vendor ID (Hex):").grid(
        row=0, column=0, padx=5, pady=5, sticky="e"
    )
    self.entry_vid = tk.Entry(config_frame, width=12)
    self.entry_vid.grid(row=0, column=1, padx=5, pady=5)
    self.entry_vid.insert(0, "0x045E")  # Valor por defecto

    tk.Label(config_frame, text="Product ID (Hex):").grid(
        row=0, column=2, padx=5, pady=5, sticky="e"
    )
    self.entry_pid = tk.Entry(config_frame, width=12)
    self.entry_pid.grid(row=0, column=3, padx=5, pady=5)
    self.entry_pid.insert(0, "0x028E")  # Valor por defecto

    # Botones de control
    self.btn_scan = tk.Button(
        config_frame, text="Listar Dispositivos", command=self.listar_dispositivos
    )
    self.btn_scan.grid(row=1, column=0, columnspan=2, pady=5, sticky="ew")

    self.btn_toggle = tk.Button(
        config_frame,
        text="Iniciar Monitoreo",
        bg="#4CAF50",
        fg="white",
        font=("Helvetica", 9, "bold"),
        command=self.toggle_monitoreo,
    )
    self.btn_toggle.grid(row=1, column=2, columnspan=2, pady=5, sticky="ew")

    # --- Área de Monitoreo / Log ---
    log_frame = tk.LabelFrame(
        root, text=" Monitor de Interrupciones en Vivo ", padx=10, pady=10
    )
    log_frame.pack(fill="both", expand=True, padx=10, pady=5)

    self.txt_log = scrolledtext.ScrolledText(
        log_frame,
        wrap=tk.WORD,
        font=("Consolas", 10),
        bg="#1E1E1E",
        fg="#00FF00",
    )
    self.txt_log.pack(fill="both", expand=True)

  def log_message(self, message):

    """Escribe mensajes en el área de texto con scroll automático."""
    self.txt_log.insert(tk.END, message + "\n")
    self.txt_log.see(tk.END)

  def listar_dispositivos(self):

    """Escanea el bus HID e imprime los dispositivos activos."""
    self.txt_log.delete("1.0", tk.END)
    self.log_message("=== DISPOSITIVOS HID CONECTADOS ===")
    try:
      devices = hid.enumerate()
      if not devices:
        self.log_message("No se encontraron dispositivos HID.")
        return

      for dev in devices:
        vid_hex = hex(dev["vendor_id"])
        pid_hex = hex(dev["product_id"])
        prod_name = dev["product_string"] or "Desconocido"
        self.log_message(
            f"VID: {vid_hex} | PID: {pid_hex} | Dispositivo: {prod_name}"
        )
    except Exception as e:
      self.log_message(f"Error al enumerar dispositivos: {e}")

  def toggle_monitoreo(self):

    """Inicia o detiene el bucle de lectura."""
    if not self.is_monitoring:
      # Validar Hexadecimales
      try:
        self.vid = int(self.entry_vid.get(), 16)
        self.pid = int(self.entry_pid.get(), 16)
      except ValueError:
        messagebox.showerror(
            "Error de Entrada",
            "Introduce valores hexadecimales válidos (Ejemplo: 0x045E o"
            " 045E).",
        )
        return

      # Intentar conectar
      try:
        self.device = hid.device()
        self.device.open(self.vid, self.pid)
        self.device.set_nonblocking(True)
      except IOError as err:
        messagebox.showerror(
            "Error de Conexión",
            f"No se pudo abrir el dispositivo ({hex(self.vid)}:"
            f" {hex(self.pid)}).\n\nDetalle: {err}",
        )
        return

      # Cambiar estado e iniciar Hilo
      self.is_monitoring = True
      self.btn_toggle.config(text="Detener Monitoreo", bg="#F44336")
      self.log_message(
          f"\n[+] Conectado a {hex(self.vid)}:{hex(self.pid)}. Escuchando"
          " datos...\n"
      )

      self.monitor_thread = threading.Thread(
          target=self.leer_loop, daemon=True
      )
      self.monitor_thread.start()

    else:
      # Detener monitoreo
      self.is_monitoring = False
      self.btn_toggle.config(text="Iniciar Monitoreo", bg="#4CAF50")
      if self.device:
        self.device.close()
        self.device = None
      self.log_message("\n[-] Monitoreo detenido.\n")

  def leer_loop(self):

    """Hilo secundario: lee datos continuamente sin bloquear la interfaz."""
    ultimo_estado = None

    while self.is_monitoring and self.device:
      try:
        data = self.device.read(64)
        if data:
          if data != ultimo_estado:
            # Formatear la trama de datos a Hexadecimal legible
            hex_data = " ".join([f"{b:02X}" for b in data])
            timestamp = time.strftime("%H:%M:%S")
            mensaje = f"[{timestamp}] Bytes: {hex_data}"

            # Actualizar la interfaz de forma segura
            self.root.after(0, self.log_message, mensaje)
            ultimo_estado = data
        time.sleep(0.01)  # Pequeño delay para no sobrecargar el CPU
      except Exception as e:
        self.root.after(0, self.log_message, f"Error en lectura: {e}")
        break


if __name__ == "__main__":
  root = tk.Tk()
  app = JoystickMonitorApp(root)
  root.mainloop()
